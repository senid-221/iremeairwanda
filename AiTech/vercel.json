{
  "buildCommand": null,
  "outputDirectory": "AiTech",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/js/api-client.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://iremeairwanda-1.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://iremeairwanda-1.onrender.com/media/:path*"
    }
  ],
  "redirects": []
}

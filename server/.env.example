# IREME Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Application
NODE_ENV=development
PORT=10000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ireme?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/ireme?schema=public

# Frontend URL (Vercel)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:10000/api/auth/google/callback

# Session Security
SESSION_SECRET=your_long_random_session_secret_here_minimum_32_chars

# Admin Bootstrap (one-time secret for first admin creation)
ADMIN_BOOTSTRAP_SECRET=your_one_time_admin_bootstrap_secret_here

# AI Video Lesson Generation
VIDEO_GENERATION_ENABLED=false
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
VIDEO_RENDERER=ffmpeg
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# FFMPEG_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
VIDEO_MAX_CONCURRENT_JOBS=2
VIDEO_DAILY_QUOTA_PER_USER=10
VIDEO_MAX_DURATION_MINUTES=8
VIDEO_STALE_JOB_MINUTES=30
VIDEO_WORKER_POLL_MS=10000

# Object storage for finished videos.
# VIDEO_STORAGE_MODE=s3 enables S3 mode; otherwise local temp storage is used (dev only).
# VIDEO_STORAGE_MODE=s3
# OBJECT_STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=ireme-videos
# OBJECT_STORAGE_ACCESS_KEY=your_object_storage_access_key
# OBJECT_STORAGE_SECRET_KEY=your_object_storage_secret_key
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# Optional: JWT (only if using JWT tokens instead of sessions)
# JWT_SECRET=your_jwt_secret_here

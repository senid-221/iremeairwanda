# IREME Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Application
NODE_ENV=development
PORT=10000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ireme?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/ireme?schema=public

# Frontend URL (Vercel)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:10000/api/auth/google/callback

# Session Security
SESSION_SECRET=your_long_random_session_secret_here_minimum_32_chars

# Admin Bootstrap (one-time secret for first admin creation)
ADMIN_BOOTSTRAP_SECRET=your_one_time_admin_bootstrap_secret_here

# Optional: JWT (only if using JWT tokens instead of sessions)
# JWT_SECRET=your_jwt_secret_here

  verifiedBy      String?
  verifiedAt      DateTime?
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([examinationType])
  @@index([subjectId])
  @@index([educationLevelId])
  @@index([year])
  @@index([verificationStatus])

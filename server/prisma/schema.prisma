generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SECTION 1: AUTHENTICATION AND USER MANAGEMENT
// ============================================

enum Role {
  STUDENT
  TEACHER
  PARENT
  HEADTEACHER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  emailNormalized String        @unique
  fullName        String
  passwordHash    String?
  role            Role          @default(STUDENT)
  status          AccountStatus @default(PENDING)
  emailVerified   Boolean       @default(false)
  avatarUrl       String?
  phone           String?
  dateOfBirth     DateTime?
  gender          String?
  preferredLanguage String      @default("en")
  timezone        String        @default("Africa/Kigali")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  
  profileComplete Boolean @default(false)
  cvUrl           String?
  faceScanUrl     String?
  educationTrack  String?

  userProfile       UserProfile?
  oauthAccounts     OAuthAccount[]
  sessions          Session[]
  userRoles         UserRole[]
  emailVerification EmailVerificationToken[]
  passwordResets    PasswordResetToken[]
  loginAuditLogs    LoginAuditLog[]
  accountInvitationsSent AccountInvitation[] @relation("InvitationSender")
  accountInvitationsReceived AccountInvitation[] @relation("InvitationRecipient")
  
  studentProfile    StudentProfile?
  parentProfile     ParentProfile?
  
  schoolMemberships SchoolMembership[]
  schoolClaimRequests SchoolClaimRequest[]
  schoolVerificationRecords SchoolVerificationRecord[]
  schoolLeadershipAppointments SchoolLeadershipAppointment[]
  approvedMemberships SchoolMembership[] @relation("MembershipApprover")
  approvedAppointments SchoolLeadershipAppointment[] @relation("AppointmentApprover")
  
  gameMatchesPlayer1 GameMatch[] @relation("Player1")
  gameMatchesPlayer2 GameMatch[] @relation("Player2")
  gamePlayers       GamePlayer[]
  gameAnswers       GameAnswer[]
  gameInvitationsSent GameInvitation[] @relation("InvitationSender")
  gameInvitationsReceived GameInvitation[] @relation("InvitationRecipient")
  gameAchievements  UserAchievement[]
  
  aiConversations   AiConversation[]
  learningActivities LearningActivityLog[]
  studentProgress   StudentProgress[]
  studentSkillMastery StudentSkillMastery[]
  
  userSubscriptions UserSubscription[]
  notifications     Notification[]
  notificationPreferences NotificationPreference[]
  supportTickets    SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  
  auditLogsCreated  AuditLog[] @relation("AuditCreator")
  auditLogsTarget   AuditLog[] @relation("AuditTarget")
  adminAuditLogs    AdminAuditLog[] @relation("AdminAuditActor")
  adminApprovals    AdminApprovalRequest[] @relation("ApprovalRequester")
  adminApprovalsProcessed AdminApprovalRequest[] @relation("ApprovalProcessor")

  userRoleGrants    UserRole[] @relation("UserRoleGranter")
  paymentTransactions PaymentTransaction[]

  videoLessons      VideoLesson[]
  videoGenerationJobs VideoGenerationJob[]
  videoLessonProgress VideoLessonProgress[]

  tutorProfile      TutorProfile?
  studentBookings   Booking[] @relation("StudentBookings")
  parentBookings    Booking[] @relation("ParentBookings")
  tutorReviewsGiven TutorReview[] @relation("TutorReviewsGiven")
  bookingNotifications BookingNotification[]
  savedTutors       TutorSave[]

  schoolEvents      SchoolEvent[]
  parentMeetings    ParentMeeting[]
  teacherReportRequestsSent TeacherReportRequest[] @relation("ReportRequester")
  teacherReportRequestsReceived TeacherReportRequest[] @relation("ReportRecipient")
  parentMessagesSent ParentMessage[] @relation("MessageSender")
  parentMessagesReceived ParentMessage[] @relation("MessageRecipient")
  schoolFees        SchoolFee[]

  learningTasks     LearningTask[]
  aiUsageLogs       AiUsageLog[]
  generatedImages   GeneratedImage[]

  @@index([email])
  @@index([emailNormalized])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  firstName       String?
  lastName        String?
  displayName     String?
  bio             String?
  profilePicture  String?
  coverImage      String?
  website         String?
  location        String?
  country         String?  @default("Rwanda")
  province        String?
  district        String?
  sector          String?
  cell            String?
  village         String?
  provinceId      String?
  districtId      String?
  sectorId        String?
  cellId          String?
  villageId       String?
  postalCode      String?
  emergencyContact String?
  emergencyPhone  String?
  nationality     String?
  nationalId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provinceRef     Province? @relation("UserProfileProvince", fields: [provinceId], references: [id])
  districtRef     District? @relation("UserProfileDistrict", fields: [districtId], references: [id])
  sectorRef       Sector?   @relation("UserProfileSector", fields: [sectorId], references: [id])
  cellRef         Cell?     @relation("UserProfileCell", fields: [cellId], references: [id])
  villageRef      Village?  @relation("UserProfileVillage", fields: [villageId], references: [id])

  @@index([userId])
  @@index([provinceId])
  @@index([districtId])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  email             String?
  displayName       String?
  photoUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, providerAccountId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  grantedBy String?
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("UserRoleGranter", fields: [grantedBy], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RoleDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([name])
  @@index([resource, action])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Session {
  id         String   @id
  sid        String   @unique
  userId     String?
  data       Json
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastActive DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sid])
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model LoginAuditLog {
  id          String   @id @default(uuid())
  userId      String?
  email       String?
  action      String
  ipAddress   String?
  userAgent   String?
  location    String?
  success     Boolean
  failureReason String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
  @@index([ipAddress])
}

model AccountInvitation {
  id          String   @id @default(uuid())
  email       String
  role        Role
  invitedBy   String
  token       String   @unique
  status      String   @default("pending")
  expiresAt   DateTime
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender   User @relation("InvitationSender", fields: [invitedBy], references: [id])
  recipient User? @relation("InvitationRecipient", fields: [email], references: [email])

  @@index([token])
  @@index([email])
  @@index([invitedBy])
  @@index([status])
}

// ============================================
// SECTION 2: EDUCATION LEVELS AND CURRICULUM
// ============================================

model EducationLevel {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  nameEn          String
  nameRw          String?
  description     String?
  levelType       String
  gradeRange      String?
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYears       AcademicYear[]
  levelSubjects       LevelSubject[]
  curriculumProgrammes CurriculumProgramme[]
  subjectCombinations SubjectCombination[]
  schoolLevels        SchoolLevel[]
  studentEnrollments StudentEnrollment[]
  resourceCurriculumLinks ResourceCurriculumLink[]
  questionCurriculumLinks QuestionCurriculumLink[]
  tutorSubjects       TutorSubject[]
  bookings            Booking[]
  currentStudents     StudentProfile[] @relation("StudentCurrentLevel")
  studentSubjects     StudentSubject[]

  @@index([code])
  @@index([levelType])
  @@index([isActive])
}

model AcademicYear {
  id            String   @id @default(uuid())
  educationLevelId String
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  curriculumVersions CurriculumVersion[]
  studentEnrollments StudentEnrollment[]
  levelSubjects LevelSubject[]

  @@unique([educationLevelId, name])
  @@index([educationLevelId])
  @@index([isCurrent])
}

model CurriculumVersion {
  id              String   @id @default(uuid())
  academicYearId  String
  name            String
  version         String
  effectiveDate   DateTime
  description     String?
  isOfficial      Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  curriculumSources CurriculumSource[]
  curriculumTopics CurriculumTopic[]
  curriculumModules CurriculumModule[]
  resourceCurriculumLinks ResourceCurriculumLink[]
  questionCurriculumLinks QuestionCurriculumLink[]

  @@index([academicYearId])
  @@index([isOfficial])
}

model CurriculumSource {
  id                  String   @id @default(uuid())
  curriculumVersionId String
  institutionName     String
  documentTitle       String
  documentUrl         String?
  verificationStatus  String   @default("pending")
  verifiedBy          String?
  verifiedAt          DateTime?
  reviewDate          DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  curriculumChangeLogs CurriculumChangeLog[]

  @@index([curriculumVersionId])
  @@index([verificationStatus])
}

model CurriculumProgramme {
  id              String   @id @default(uuid())
  educationLevelId String
  code            String   @unique
  name            String
  nameEn          String
  nameRw          String?
  description     String?
  programmeType   String
  qualificationLevel String?
  tradeCategory   String?
  durationYears   Int?
  awardingAuthority String?
  sourceName      String?
  verificationStatus String @default("pending")
  lastReviewedAt DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  curriculumOptions CurriculumOption[]
  studentEnrollments StudentEnrollment[]

  @@index([code])
  @@index([educationLevelId])
  @@index([programmeType])
  @@index([verificationStatus])
}

model CurriculumOption {
  id                  String   @id @default(uuid())
  curriculumProgrammeId String
  code                String   @unique
  name                String
  nameEn              String
  nameRw              String?
  description         String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  curriculumProgramme CurriculumProgramme @relation(fields: [curriculumProgrammeId], references: [id], onDelete: Cascade)
  studentEnrollments StudentEnrollment[]

  @@index([code])
  @@index([curriculumProgrammeId])
}

model Subject {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameEn      String
  nameRw      String?
  description String?
  subjectType String
  iconUrl     String?
  sourceName  String?
  verificationStatus String @default("pending")
  lastReviewedAt DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levelSubjects LevelSubject[]
  combinationSubjects CombinationSubject[]
  questionBanks QuestionBank[]
  schoolSubjects SchoolSubject[]
  teacherAssignments TeacherAssignment[]
  resourceCurriculumLinks ResourceCurriculumLink[]
  tutorSubjects   TutorSubject[]
  bookings        Booking[]
  studentSubjects StudentSubject[]

  @@index([code])
  @@index([subjectType])
  @@index([isActive])
  @@index([verificationStatus])
}

model LevelSubject {
  id              String   @id @default(uuid())
  educationLevelId String
  subjectId       String
  academicYearId  String?
  isCore          Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  subjectTopics SubjectTopic[]
  studentProgress StudentProgress[]

  @@unique([educationLevelId, subjectId, academicYearId])
  @@index([educationLevelId])
  @@index([subjectId])
}

model CurriculumTopic {
  id                  String   @id @default(uuid())
  curriculumVersionId String
  code                String
  name                String
  nameEn              String
  nameRw              String?
  description         String?
  displayOrder        Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  subjectTopics SubjectTopic[]
  resourceCurriculumLinks ResourceCurriculumLink[]
  questionCurriculumLinks QuestionCurriculumLink[]

  @@unique([curriculumVersionId, code])
  @@index([curriculumVersionId])
}

model SubjectTopic {
  id              String   @id @default(uuid())
  levelSubjectId  String
  curriculumTopicId String
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  levelSubject LevelSubject @relation(fields: [levelSubjectId], references: [id], onDelete: Cascade)
  curriculumTopic CurriculumTopic @relation(fields: [curriculumTopicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([levelSubjectId, curriculumTopicId])
  @@index([levelSubjectId])
  @@index([curriculumTopicId])
}

model SubjectCombination {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  nameEn          String
  nameRw          String?
  description     String?
  educationLevelId String
  combinationType String   @default("general")
  sourceName      String?
  verificationStatus String @default("pending")
  lastReviewedAt DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  combinationSubjects CombinationSubject[]

  @@index([code])
  @@index([educationLevelId])
  @@index([verificationStatus])
}

model CombinationSubject {
  id              String   @id @default(uuid())
  combinationId   String
  subjectId       String
  isRequired      Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  combination SubjectCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([combinationId, subjectId])
  @@index([combinationId])
  @@index([subjectId])
}

model CurriculumModule {
  id                  String   @id @default(uuid())
  curriculumVersionId String
  code                String
  name                String
  nameEn              String
  nameRw              String?
  description         String?
  moduleType          String
  displayOrder        Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  moduleCompetencies ModuleCompetency[]

  @@unique([curriculumVersionId, code])
  @@index([curriculumVersionId])
  @@index([moduleType])
}

model ModuleCompetency {
  id              String   @id @default(uuid())
  curriculumModuleId String
  code            String
  name            String
  nameEn          String
  nameRw          String?
  description     String?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  curriculumModule CurriculumModule @relation(fields: [curriculumModuleId], references: [id], onDelete: Cascade)

  @@unique([curriculumModuleId, code])
  @@index([curriculumModuleId])
}

model CurriculumImportJob {
  id              String   @id @default(uuid())
  sourceName      String
  sourceType      String
  importStatus    String   @default("pending")
  totalRecords    Int      @default(0)
  importedRecords Int      @default(0)
  failedRecords   Int      @default(0)
  errorLog        Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([importStatus])
  @@index([startedAt])
}

model CurriculumChangeLog {
  id              String   @id @default(uuid())
  curriculumSourceId String
  changeType      String
  entityType      String
  entityId        String
  previousData    Json?
  newData         Json?
  changedBy       String?
  changeReason    String?
  createdAt       DateTime @default(now())

  curriculumSource CurriculumSource @relation(fields: [curriculumSourceId], references: [id], onDelete: Cascade)

  @@index([curriculumSourceId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================
// SECTION 3: SCHOOLS AND EDUCATION STAFF
// ============================================

model School {
  id              String   @id @default(uuid())
  code            String?  @unique
  name            String
  nameEn          String
  nameRw          String?
  schoolType      String
  category        String?
  ownership       String?
  status          String   @default("active")
  isVerified      Boolean  @default(false)
  verifiedAt      DateTime?
  verifiedBy      String?
  registrationStatus String @default("pending")
  logoUrl         String?
  documents       Json?
  registeredBy    String?
  registeredAt    DateTime?
  reviewNotes     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schoolLocation SchoolLocation?
  schoolContacts SchoolContact[]
  schoolLevels   SchoolLevel[]
  schoolSubjects SchoolSubject[]
  schoolMemberships SchoolMembership[]
  schoolClaimRequests SchoolClaimRequest[]
  schoolVerificationRecords SchoolVerificationRecord[]
  teacherAssignments TeacherAssignment[]
  classes        Class[]
  schoolAnnouncements SchoolAnnouncement[]
  studentEnrollments StudentEnrollment[]
  leadershipAppointments SchoolLeadershipAppointment[]
  currentStudents StudentProfile[] @relation("StudentCurrentSchool")
  currentTutors  TutorProfile[] @relation("TutorCurrentSchool")
  tutorAffiliations TutorSchoolAffiliation[]
  schoolEvents   SchoolEvent[]
  parentMeetings ParentMeeting[]
  schoolFees     SchoolFee[]
  teacherReportRequests TeacherReportRequest[]
  schoolDocuments SchoolDocument[]

  @@index([code])
  @@index([schoolType])
  @@index([status])
  @@index([isVerified])
  @@index([registrationStatus])
}

model SchoolDocument {
  id              String   @id @default(uuid())
  schoolId        String
  title           String
  titleEn         String?
  titleRw         String?
  documentType    String   // fees, materials, instructions, announcement
  description     String?
  fileUrl         String?
  academicYear    String?
  publishedAt     DateTime?
  dueDate         DateTime?
  amount          Decimal?
  currency        String?  @default("RWF")
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([documentType])
  @@index([isActive])
  @@index([publishedAt])
}

model SchoolLocation {
  id          String   @id @default(uuid())
  schoolId    String   @unique
  province    String?
  district    String?
  sector      String?
  cell        String?
  village     String?
  provinceId  String?
  districtId  String?
  sectorId    String?
  cellId      String?
  villageId   String?
  address     String?
  latitude    Decimal?
  longitude   Decimal?
  postalCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  provinceRef Province? @relation("SchoolLocationProvince", fields: [provinceId], references: [id])
  districtRef District? @relation("SchoolLocationDistrict", fields: [districtId], references: [id])
  sectorRef   Sector?   @relation("SchoolLocationSector", fields: [sectorId], references: [id])
  cellRef     Cell?     @relation("SchoolLocationCell", fields: [cellId], references: [id])
  villageRef  Village?  @relation("SchoolLocationVillage", fields: [villageId], references: [id])

  @@index([schoolId])
  @@index([district])
  @@index([provinceId])
  @@index([districtId])
}

model SchoolContact {
  id            String   @id @default(uuid())
  schoolId      String
  contactType   String
  contactValue  String
  isPrimary     Boolean  @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([contactType])
}

model SchoolLevel {
  id              String   @id @default(uuid())
  schoolId        String
  educationLevelId String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)

  @@unique([schoolId, educationLevelId])
  @@index([schoolId])
  @@index([educationLevelId])
}

model SchoolSubject {
  id          String   @id @default(uuid())
  schoolId    String
  subjectId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
}

model SchoolMembership {
  id          String   @id @default(uuid())
  schoolId    String
  userId      String
  role        String
  isPrimary   Boolean  @default(false)
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  status      String   @default("active")
  approvedBy  String?

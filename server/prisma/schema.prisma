  entityType      String
  entityId        String
  requestedBy     String
  status          String   @default("pending")
  requestData     Json?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  decision        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requester User @relation("ApprovalRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  processor User? @relation("ApprovalProcessor", fields: [reviewedBy], references: [id])

  @@index([requestType])
  @@index([entityType])
  @@index([requestedBy])
  @@index([status])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  settingKey  String   @unique
  settingValue String
  valueType   String   @default("string")
  description String?
  isPublic    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([settingKey])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  flagKey     String   @unique
  flagName    String
  description String?
  isEnabled   Boolean  @default(false)
  rolloutPercent Int?
  targetUserRoles Json?
  targetUserIds Json?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flagKey])
  @@index([isEnabled])
}

model IntegrationConfiguration {
  id              String   @id @default(uuid())
  integrationKey  String   @unique
  integrationName String
  provider        String
  configData      Json?
  isActive        Boolean  @default(true)
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([integrationKey])
  @@index([provider])
  @@index([isActive])
}

model BackgroundJob {
  id              String   @id @default(uuid())
  jobType         String
  jobName         String
  status          String   @default("pending")
  payload         Json?
  result          Json?
  error           String?
  priority        Int      @default(0)
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  scheduledAt     DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([jobType])
  @@index([status])
  @@index([scheduledAt])
  @@index([priority])
}

model DataImportJob {
  id              String   @id @default(uuid())
  importType      String
  sourceName      String
  sourceType      String
  status          String   @default("pending")
  totalRecords    Int      @default(0)
  importedRecords Int      @default(0)
  failedRecords   Int      @default(0)
  skippedRecords  Int      @default(0)
  errorLog        Json?
  fileUrl         String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([importType])
  @@index([status])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// AI video lessons
// ---------------------------------------------------------------------------

model VideoLesson {
  id                 String    @id @default(uuid())
  userId             String
  subjectId          String?
  educationLevelId   String?
  topicKey           String?
  topicName          String
  language           String    @default("en")
  durationMinutes    Int       @default(5)
  title              String?
  description        String?
  learningObjectives Json?
  status             String    @default("generating")
  videoUrl           String?
  captionUrl         String?
  transcript         Json?
  durationSeconds    Int?
  fileSizeBytes      Int?
  resolution         String?
  provider           String    @default("openai")
  modelUsed          String?
  curriculumRef      String?
  sourceUrls         Json?
  isAiGenerated      Boolean   @default(true)
  aiDisclosure       String    @default("This lesson was generated by IREME AI. Narration and illustrations are AI-generated and reviewed against the Rwanda curriculum.")
  reviewStatus       String    @default("unreviewed")
  reviewedBy         String?
  reviewedAt         DateTime?
  errorMessage       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes      VideoLessonScene[]
  job         VideoGenerationJob?
  assets      VideoLessonAsset[]
  assessments VideoLessonAssessment[]
  progress    VideoLessonProgress[]

  @@index([userId])
  @@index([status])
  @@index([subjectId])
  @@index([educationLevelId])
  @@index([reviewStatus])
  @@index([createdAt])
}

model VideoLessonScene {
  id                String   @id @default(uuid())
  videoLessonId     String
  sceneNumber       Int
  title             String
  narrationText     String
  captionText       String
  visualDescription String
  visualType        String   @default("generated")
  imageUrl          String?
  audioUrl          String?
  startSeconds      Decimal  @default(0)
  durationSeconds   Decimal  @default(0)

  videoLesson VideoLesson @relation(fields: [videoLessonId], references: [id], onDelete: Cascade)

  @@unique([videoLessonId, sceneNumber])
  @@index([videoLessonId])
}

model VideoGenerationJob {
  id             String    @id @default(uuid())
  videoLessonId  String    @unique
  userId         String
  status         String    @default("queued")
  stage          String    @default("queued")
  progress       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  dedupeKey      String?
  provider       String    @default("openai")
  error          String?
  costEstimate   Decimal   @default(0)
  queuedAt       DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  videoLesson VideoLesson @relation(fields: [videoLessonId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([dedupeKey])
  @@index([queuedAt])
}

model VideoLessonAsset {
  id            String    @id @default(uuid())
  videoLessonId String
  assetType     String
  storageKey    String
  url           String?
  contentType   String?
  sizeBytes     Int?
  isTemporary   Boolean   @default(false)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  videoLesson VideoLesson @relation(fields: [videoLessonId], references: [id], onDelete: Cascade)

  @@index([videoLessonId])
  @@index([assetType])
  @@index([isTemporary, expiresAt])
}

model VideoLessonAssessment {
  id             String   @id @default(uuid())
  videoLessonId  String
  questionText   String
  questionOptions Json
  correctIndex   Int
  explanation    String
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())

  videoLesson VideoLesson @relation(fields: [videoLessonId], references: [id], onDelete: Cascade)

  @@index([videoLessonId])
}

model VideoLessonProgress {
  id                  String    @id @default(uuid())
  videoLessonId       String
  userId              String
  lastPositionSeconds Int       @default(0)
  watchedSeconds      Int       @default(0)
  completionPercent   Int       @default(0)
  completedAt         DateTime?
  quizCompletedAt     DateTime?
  quizScore           Int?
  quizTotal           Int?
  savedToLibrary      Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  videoLesson VideoLesson @relation(fields: [videoLessonId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoLessonId])
  @@index([userId])
  @@index([videoLessonId])
}

// ============================================
// SECTION 10: RWANDA ADMINISTRATIVE LOCATIONS
// ============================================

model Province {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  nameEn       String
  nameRw       String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  districts    District[]

  userProfileRefs      UserProfile[]      @relation("UserProfileProvince")
  schoolLocationRefs   SchoolLocation[]   @relation("SchoolLocationProvince")
  tutorServiceAreaRefs TutorServiceArea[] @relation("TutorServiceProvince")
}

model District {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  nameEn       String
  nameRw       String?
  provinceId   String
  province     Province @relation(fields: [provinceId], references: [id])
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  sectors      Sector[]

  userProfileRefs      UserProfile[]      @relation("UserProfileDistrict")
  schoolLocationRefs   SchoolLocation[]   @relation("SchoolLocationDistrict")
  tutorServiceAreaRefs TutorServiceArea[] @relation("TutorServiceDistrict")
}

model Sector {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  nameEn       String
  nameRw       String?
  districtId   String
  district     District @relation(fields: [districtId], references: [id])
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  cells        Cell[]

  userProfileRefs      UserProfile[]      @relation("UserProfileSector")
  schoolLocationRefs   SchoolLocation[]   @relation("SchoolLocationSector")
  tutorServiceAreaRefs TutorServiceArea[] @relation("TutorServiceSector")
}

model Cell {
  id           String  @id @default(uuid())
  code         String  @unique
  name         String
  nameEn       String
  nameRw       String?
  sectorId     String
  sector       Sector  @relation(fields: [sectorId], references: [id])
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  villages     Village[]

  userProfileRefs      UserProfile[]      @relation("UserProfileCell")
  schoolLocationRefs   SchoolLocation[]   @relation("SchoolLocationCell")
  tutorServiceAreaRefs TutorServiceArea[] @relation("TutorServiceCell")
}

model Village {
  id           String  @id @default(uuid())
  code         String  @unique
  name         String
  nameEn       String
  nameRw       String?
  cellId       String
  cell         Cell    @relation(fields: [cellId], references: [id])
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  userProfileRefs      UserProfile[]      @relation("UserProfileVillage")
  schoolLocationRefs   SchoolLocation[]   @relation("SchoolLocationVillage")
  tutorServiceAreaRefs TutorServiceArea[] @relation("TutorServiceVillage")
}

// ============================================
// SECTION: TEACHER BOOKING & AI SKILLS MATCHING
// ============================================

model TutorProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  headline              String?
  bio                   String?
  hourlyRate            Float?
  currency              String   @default("RWF")
  experienceYears       Int?
  teachingPhilosophy    String?
  languages             String[]
  lessonFormats         String[] // ONLINE, IN_PERSON_AT_TUTOR, IN_PERSON_AT_STUDENT
  isAvailable           Boolean  @default(true)
  profileVisibility     String   @default("public") // public, private, unlisted
  cvUrl                 String?
  cvAnalyzedAt          DateTime?
  cvAnalysisVersion     String?
  totalBookings         Int      @default(0)
  completedLessons      Int      @default(0)
  cancellationRate      Float    @default(0)
  responseRate          Float    @default(0)
  avgResponseTimeMins   Int?
  rating                Float    @default(0)
  reviewCount           Int      @default(0)
  verificationStatus    String   @default("unverified") // unverified, pending, verified, rejected
  verifiedAt            DateTime?
  verifiedBy            String?
  profileApproved       Boolean  @default(false)
  approvedAt            DateTime?
  approvedBy            String?
  currentSchoolId       String?
  offersPrivateTutoring Boolean  @default(false)
  offersOnlineLessons   Boolean  @default(true)
  offersHomeLessons     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSchool         School? @relation("TutorCurrentSchool", fields: [currentSchoolId], references: [id])
  subjects              TutorSubject[]
  serviceAreas          TutorServiceArea[]
  availability          TutorAvailability[]
  skillAssessments      TutorSkillAssessment[]
  verifications         TutorVerification[]
  bookingsAsTutor       Booking[] @relation("TutorBookings")
  reviews               TutorReview[]
  savedBy               TutorSave[]
  schoolAffiliations    TutorSchoolAffiliation[]

  @@index([userId])
  @@index([verificationStatus])
  @@index([isAvailable])
  @@index([rating])
}

model TutorSubject {
  id                    String   @id @default(uuid())
  tutorProfileId        String
  subjectId             String
  educationLevelId      String?
  proficiencyLevel      String   @default("proficient") // beginner, developing, proficient, advanced
  aiScore               Float?
  aiConfidence          Float?
  aiEvidence            Json?
  aiAssessedAt          DateTime?
  manuallyVerified      Boolean  @default(false)
  verifiedBy            String?
  verifiedAt            DateTime?
  hourlyRateOverride    Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tutorProfile          TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject               Subject @relation(fields: [subjectId], references: [id])
  educationLevel        EducationLevel? @relation(fields: [educationLevelId], references: [id])

  @@unique([tutorProfileId, subjectId, educationLevelId])
  @@index([tutorProfileId])
  @@index([subjectId])
  @@index([educationLevelId])
}

model TutorServiceArea {
  id                    String   @id @default(uuid())
  tutorProfileId        String
  province              String?
  district              String?
  sector                String?
  cell                  String?
  village               String?
  provinceId            String?
  districtId            String?
  sectorId              String?
  cellId                String?
  villageId             String?
  servesOnline          Boolean  @default(false)
  createdAt             DateTime @default(now())

  tutorProfile          TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  provinceRef           Province? @relation("TutorServiceProvince", fields: [provinceId], references: [id])
  districtRef           District? @relation("TutorServiceDistrict", fields: [districtId], references: [id])
  sectorRef             Sector? @relation("TutorServiceSector", fields: [sectorId], references: [id])
  cellRef               Cell? @relation("TutorServiceCell", fields: [cellId], references: [id])
  villageRef            Village? @relation("TutorServiceVillage", fields: [villageId], references: [id])

  @@index([tutorProfileId])
  @@index([provinceId])
  @@index([districtId])
}

model TutorAvailability {
  id                    String   @id @default(uuid())
  tutorProfileId        String
  dayOfWeek             Int // 0=Sunday, 6=Saturday
  startTime             String // HH:mm format
  endTime               String // HH:mm format
  isRecurring           Boolean  @default(true)
  specificDate          DateTime? // For one-off availability
  isBooked              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tutorProfile          TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId])
  @@index([dayOfWeek])
}

model TutorSkillAssessment {
  id                    String   @id @default(uuid())
  tutorProfileId        String
  skillName             String
  skillCategory         String // subject, pedagogy, communication, technology
  score                 Float // 0-100
  level                 String // beginner, developing, proficient, advanced
  confidence            Float // 0-1
  evidence              Json?
  rubricVersion         String
  modelVersion          String
  assessedAt            DateTime @default(now())
  expiresAt             DateTime?
  overriddenBy          String?
  overrideReason        String?
  overriddenAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tutorProfile          TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId])
  @@index([skillCategory])
  @@index([score])
}

model TutorVerification {
  id                    String   @id @default(uuid())
  tutorProfileId        String
  verificationType      String // identity, qualification, cv_review, background_check
  status                String // pending, approved, rejected
  submittedAt           DateTime @default(now())
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewNotes           String?
  documentUrls          String[]
  rejectionReason       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tutorProfile          TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId])
  @@index([status])
  @@index([verificationType])
}

model Booking {
  id                    String   @id @default(uuid())
  bookingNumber         String   @unique
  tutorProfileId        String
  studentUserId         String
  parentUserId          String?
  studentProfileId      String?
  subjectId             String
  educationLevelId      String?
  topicIds              String[]
  lessonFormat          String // ONLINE, IN_PERSON_AT_TUTOR, IN_PERSON_AT_STUDENT
  status                String   @default("pending") // pending, accepted, declined, cancelled, completed, rescheduled
  scheduledDate         DateTime
  startTime             String // HH:mm
  endTime               String // HH:mm
  durationMinutes       Int
  location              String?
  onlineMeetingUrl      String?
  hourlyRate            Float
  totalAmount           Float
  currency              String   @default("RWF")
  learningObjectives    String?
  specialRequirements   String?
  cancellationReason    String?
  cancelledAt           DateTime?
  cancelledBy           String?
  rescheduledFromId     String?
  completedAt           DateTime?
  tutorConfirmedAt      DateTime?
  studentNotifiedAt     DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tutorProfile          TutorProfile @relation("TutorBookings", fields: [tutorProfileId], references: [id])
  studentUser           User @relation("StudentBookings", fields: [studentUserId], references: [id])
  parentUser            User? @relation("ParentBookings", fields: [parentUserId], references: [id])
  studentProfile        StudentProfile? @relation(fields: [studentProfileId], references: [id])
  subject               Subject @relation(fields: [subjectId], references: [id])
  educationLevel        EducationLevel? @relation(fields: [educationLevelId], references: [id])
  reviews               TutorReview[]
  notifications         BookingNotification[]

  @@index([tutorProfileId])
  @@index([studentUserId])
  @@index([parentUserId])
  @@index([status])
  @@index([scheduledDate])
  @@index([bookingNumber])
}

model BookingNotification {
  id                    String   @id @default(uuid())
  bookingId             String
  userId                String
  type                  String // booking_request, booking_accepted, booking_declined, booking_cancelled, booking_reminder, booking_completed
  title                 String
  message               String
  data                  Json?
  isRead                Boolean  @default(false)
  readAt                DateTime?
  createdAt             DateTime @default(now())

  booking               Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model TutorReview {
  id                    String   @id @default(uuid())
  bookingId             String   @unique
  tutorProfileId        String
  reviewerUserId        String
  rating                Int // 1-5
  comment               String?
  punctuality           Int? // 1-5
  professionalism       Int? // 1-5
  knowledge             Int? // 1-5
  communication         Int? // 1-5
  wouldRecommend        Boolean  @default(true)
  isVerified            Boolean  @default(false)
  verifiedAt            DateTime?
  responseFromTutor     String?
  tutorRespondedAt      DateTime?
  isAdminFlagged        Boolean  @default(false)
  flagReason            String?
  flaggedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  booking               Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutorProfile          TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  reviewerUser          User @relation("TutorReviewsGiven", fields: [reviewerUserId], references: [id])

  @@index([tutorProfileId])
  @@index([reviewerUserId])
  @@index([rating])
  @@index([bookingId])
}

model TutorSave {
  id                    String   @id @default(uuid())
  tutorProfileId        String
  userId                String
  createdAt             DateTime @default(now())

  tutorProfile          TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, userId])
  @@index([tutorProfileId])
  @@index([userId])
}

model BookingSearchLog {
  id                    String   @id @default(uuid())
  userId                String?
  subjectId             String?
  educationLevelId      String?
  locationProvince      String?
  locationDistrict      String?
  lessonFormat          String?
  filtersUsed           Json?
  resultsCount          Int?
  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model StudentSubject {
  id                String   @id @default(uuid())
  studentProfileId  String
  subjectId         String
  educationLevelId  String?
  isOptional        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject           Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  educationLevel    EducationLevel? @relation(fields: [educationLevelId], references: [id])

  @@unique([studentProfileId, subjectId])
  @@index([studentProfileId])
  @@index([subjectId])
  @@index([educationLevelId])
}

model TutorSchoolAffiliation {
  id                String   @id @default(uuid())
  tutorProfileId    String
  schoolId          String
  affiliationType   String   @default("teaches")
  isCurrent         Boolean  @default(true)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tutorProfile      TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  school            School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, schoolId])
  @@index([tutorProfileId])
  @@index([schoolId])
}

// ============================================
// SECTION 14: SCHOOL EVENTS, MEETINGS, AND COMMUNICATION
// ============================================

model SchoolEvent {
  id          String   @id @default(uuid())
  schoolId    String
  title       String
  description String?
  eventType   String   @default("GENERAL")
  startDate   DateTime
  endDate     DateTime?
  location    String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator     User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([eventType])
  @@index([startDate])

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SECTION 1: AUTHENTICATION AND USER MANAGEMENT
// ============================================

enum Role {
  STUDENT
  TEACHER
  PARENT
  HEADTEACHER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  emailNormalized String        @unique
  fullName        String
  passwordHash    String?
  role            Role          @default(STUDENT)
  status          AccountStatus @default(PENDING)
  emailVerified   Boolean       @default(false)
  avatarUrl       String?
  phone           String?
  dateOfBirth     DateTime?
  gender          String?
  preferredLanguage String      @default("en")
  timezone        String        @default("Africa/Kigali")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastLoginAt     DateTime?
  deletedAt       DateTime?

  userProfile       UserProfile?
  oauthAccounts     OAuthAccount[]
  sessions          Session[]
  userRoles         UserRole[]
  emailVerification EmailVerificationToken[]
  passwordResets    PasswordResetToken[]
  loginAuditLogs    LoginAuditLog[]
  accountInvitationsSent AccountInvitation[] @relation("InvitationSender")
  accountInvitationsReceived AccountInvitation[] @relation("InvitationRecipient")
  
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  parentProfile     ParentProfile?
  
  schoolMemberships SchoolMembership[]
  schoolClaimRequests SchoolClaimRequest[]
  schoolVerificationRecords SchoolVerificationRecord[]
  
  gameMatchesPlayer1 GameMatch[] @relation("Player1")
  gameMatchesPlayer2 GameMatch[] @relation("Player2")
  gamePlayers       GamePlayer[]
  gameAnswers       GameAnswer[]
  gameInvitationsSent GameInvitation[] @relation("InvitationSender")
  gameInvitationsReceived GameInvitation[] @relation("InvitationRecipient")
  gameAchievements  UserAchievement[]
  
  aiConversations   AiConversation[]
  learningActivities LearningActivityLog[]
  studentProgress   StudentProgress[]
  studentSkillMastery StudentSkillMastery[]
  
  userSubscriptions UserSubscription[]
  notifications     Notification[]
  notificationPreferences NotificationPreference[]
  supportTickets    SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  
  auditLogsCreated  AuditLog[] @relation("AuditCreator")
  auditLogsTarget   AuditLog[] @relation("AuditTarget")
  adminAuditLogs    AdminAuditLog[] @relation("AdminAuditActor")
  adminApprovals    AdminApprovalRequest[] @relation("ApprovalRequester")
  adminApprovalsProcessed AdminApprovalRequest[] @relation("ApprovalProcessor")

  @@index([email])
  @@index([emailNormalized])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  firstName       String?
  lastName        String?
  displayName     String?
  bio             String?
  profilePicture  String?
  coverImage      String?
  website         String?
  location        String?
  country         String?  @default("Rwanda")
  province        String?
  district        String?
  sector          String?
  cell            String?
  village         String?
  postalCode      String?
  emergencyContact String?
  emergencyPhone  String?
  nationality     String?
  nationalId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  email             String?
  displayName       String?
  photoUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, providerAccountId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  grantedBy String?
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("UserRoleGranter", fields: [grantedBy], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RoleDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([name])
  @@index([resource, action])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Session {
  id         String   @id
  sid        String   @unique
  userId     String?
  data       Json
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastActive DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sid])
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model LoginAuditLog {
  id          String   @id @default(uuid())
  userId      String?
  email       String?
  action      String
  ipAddress   String?
  userAgent   String?
  location    String?
  success     Boolean
  failureReason String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
  @@index([ipAddress])
}

model AccountInvitation {
  id          String   @id @default(uuid())
  email       String
  role        Role
  invitedBy   String
  token       String   @unique
  status      String   @default("pending")
  expiresAt   DateTime
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender   User @relation("InvitationSender", fields: [invitedBy], references: [id])
  recipient User? @relation("InvitationRecipient", fields: [email], references: [email])

  @@index([token])
  @@index([email])
  @@index([invitedBy])
  @@index([status])
}

// ============================================
// SECTION 2: EDUCATION LEVELS AND CURRICULUM
// ============================================

model EducationLevel {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  nameEn          String
  nameRw          String?
  description     String?
  levelType       String
  gradeRange      String?
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYears       AcademicYear[]
  levelSubjects       LevelSubject[]
  curriculumProgrammes CurriculumProgramme[]
  schoolLevels        SchoolLevel[]

  @@index([code])
  @@index([levelType])
  @@index([isActive])
}

model AcademicYear {
  id            String   @id @default(uuid())
  educationLevelId String
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  curriculumVersions CurriculumVersion[]
  studentEnrollments StudentEnrollment[]

  @@unique([educationLevelId, name])
  @@index([educationLevelId])
  @@index([isCurrent])
}

model CurriculumVersion {
  id              String   @id @default(uuid())
  academicYearId  String
  name            String
  version         String
  effectiveDate   DateTime
  description     String?
  isOfficial      Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  curriculumSources CurriculumSource[]
  curriculumTopics CurriculumTopic[]
  curriculumModules CurriculumModule[]
  resourceCurriculumLinks ResourceCurriculumLink[]
  questionCurriculumLinks QuestionCurriculumLink[]

  @@index([academicYearId])
  @@index([isOfficial])
}

model CurriculumSource {
  id                  String   @id @default(uuid())
  curriculumVersionId String
  institutionName     String
  documentTitle       String
  documentUrl         String?
  verificationStatus  String   @default("pending")
  verifiedBy          String?
  verifiedAt          DateTime?
  reviewDate          DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  curriculumChangeLogs CurriculumChangeLog[]

  @@index([curriculumVersionId])
  @@index([verificationStatus])
}

model CurriculumProgramme {
  id              String   @id @default(uuid())
  educationLevelId String
  code            String   @unique
  name            String
  nameEn          String
  nameRw          String?
  description     String?
  programmeType   String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  curriculumOptions CurriculumOption[]
  studentEnrollments StudentEnrollment[]

  @@index([code])
  @@index([educationLevelId])
  @@index([programmeType])
}

model CurriculumOption {
  id                  String   @id @default(uuid())
  curriculumProgrammeId String
  code                String   @unique
  name                String
  nameEn              String
  nameRw              String?
  description         String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  curriculumProgramme CurriculumProgramme @relation(fields: [curriculumProgrammeId], references: [id], onDelete: Cascade)
  studentEnrollments StudentEnrollment[]

  @@index([code])
  @@index([curriculumProgrammeId])
}

model Subject {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nameEn      String
  nameRw      String?
  description String?
  subjectType String
  iconUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levelSubjects LevelSubject[]
  subjectTopics SubjectTopic[]
  questionBanks QuestionBank[]
  gameMatches   GameMatch[]
  resourceCurriculumLinks ResourceCurriculumLink[]

  @@index([code])
  @@index([subjectType])
  @@index([isActive])
}

model LevelSubject {
  id              String   @id @default(uuid())
  educationLevelId String
  subjectId       String
  academicYearId  String?
  isCore          Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  subjectTopics SubjectTopic[]
  studentProgress StudentProgress[]

  @@unique([educationLevelId, subjectId, academicYearId])
  @@index([educationLevelId])
  @@index([subjectId])
}

model CurriculumTopic {
  id                  String   @id @default(uuid())
  curriculumVersionId String
  code                String
  name                String
  nameEn              String
  nameRw              String?
  description         String?
  displayOrder        Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  subjectTopics SubjectTopic[]
  resourceCurriculumLinks ResourceCurriculumLink[]
  questionCurriculumLinks QuestionCurriculumLink[]

  @@unique([curriculumVersionId, code])
  @@index([curriculumVersionId])
}

model SubjectTopic {
  id              String   @id @default(uuid())
  levelSubjectId  String
  curriculumTopicId String
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  levelSubject LevelSubject @relation(fields: [levelSubjectId], references: [id], onDelete: Cascade)
  curriculumTopic CurriculumTopic @relation(fields: [curriculumTopicId], references: [id], onDelete: Cascade)
  questions Question[]
  gameMatches GameMatch[]

  @@unique([levelSubjectId, curriculumTopicId])
  @@index([levelSubjectId])
  @@index([curriculumTopicId])
}

model CurriculumModule {
  id                  String   @id @default(uuid())
  curriculumVersionId String
  code                String
  name                String
  nameEn              String
  nameRw              String?
  description         String?
  moduleType          String
  displayOrder        Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  moduleCompetencies ModuleCompetency[]

  @@unique([curriculumVersionId, code])
  @@index([curriculumVersionId])
  @@index([moduleType])
}

model ModuleCompetency {
  id              String   @id @default(uuid())
  curriculumModuleId String
  code            String
  name            String
  nameEn          String
  nameRw          String?
  description     String?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  curriculumModule CurriculumModule @relation(fields: [curriculumModuleId], references: [id], onDelete: Cascade)

  @@unique([curriculumModuleId, code])
  @@index([curriculumModuleId])
}

model CurriculumImportJob {
  id              String   @id @default(uuid())
  sourceName      String
  sourceType      String
  importStatus    String   @default("pending")
  totalRecords    Int      @default(0)
  importedRecords Int      @default(0)
  failedRecords   Int      @default(0)
  errorLog        Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([importStatus])
  @@index([startedAt])
}

model CurriculumChangeLog {
  id              String   @id @default(uuid())
  curriculumSourceId String
  changeType      String
  entityType      String
  entityId        String
  previousData    Json?
  newData         Json?
  changedBy       String?
  changeReason    String?
  createdAt       DateTime @default(now())

  curriculumSource CurriculumSource @relation(fields: [curriculumSourceId], references: [id], onDelete: Cascade)

  @@index([curriculumSourceId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================
// SECTION 3: SCHOOLS AND EDUCATION STAFF
// ============================================

model School {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  nameEn          String
  nameRw          String?
  schoolType      String
  category        String?
  status          String   @default("active")
  isVerified      Boolean  @default(false)
  verifiedAt      DateTime?
  verifiedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schoolLocation SchoolLocation?
  schoolContacts SchoolContact[]
  schoolLevels   SchoolLevel[]
  schoolSubjects SchoolSubject[]
  schoolMemberships SchoolMembership[]
  schoolClaimRequests SchoolClaimRequest[]
  schoolVerificationRecords SchoolVerificationRecord[]
  teacherAssignments TeacherAssignment[]
  classes        Class[]
  schoolAnnouncements SchoolAnnouncement[]
  studentEnrollments StudentEnrollment[]

  @@index([code])
  @@index([schoolType])
  @@index([status])
  @@index([isVerified])
}

model SchoolLocation {
  id          String   @id @default(uuid())
  schoolId    String   @unique
  province    String?
  district    String?
  sector      String?
  cell        String?
  village     String?
  address     String?
  latitude    Decimal?
  longitude   Decimal?
  postalCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([district])
}

model SchoolContact {
  id            String   @id @default(uuid())
  schoolId      String
  contactType   String
  contactValue  String
  isPrimary     Boolean  @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([contactType])
}

model SchoolLevel {
  id              String   @id @default(uuid())
  schoolId        String
  educationLevelId String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)

  @@unique([schoolId, educationLevelId])
  @@index([schoolId])
  @@index([educationLevelId])
}

model SchoolSubject {
  id          String   @id @default(uuid())
  schoolId    String
  subjectId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
}

model SchoolMembership {
  id          String   @id @default(uuid())
  schoolId    String
  userId      String
  role        String
  isPrimary   Boolean  @default(false)
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@index([role])
}

model SchoolClaimRequest {
  id            String   @id @default(uuid())
  schoolId      String
  requestedBy   String
  claimReason   String?
  status        String   @default("pending")
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requester User @relation(fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([requestedBy])
  @@index([status])
}

model SchoolVerificationRecord {
  id              String   @id @default(uuid())
  schoolId        String
  verifiedBy      String
  verificationType String
  status          String
  notes           String?
  documents       Json?
  verifiedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  verifier User @relation(fields: [verifiedBy], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([verifiedBy])
  @@index([status])
  @@index([verifiedAt])
}

model SchoolStaffProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  schoolId        String?
  staffId         String?
  position        String?
  department      String?
  employmentType  String?
  hireDate        DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacherQualifications TeacherQualification[]
  teacherAssignments TeacherAssignment[]

  @@index([userId])
  @@index([schoolId])
}

model TeacherQualification {
  id              String   @id @default(uuid())
  schoolStaffProfileId String
  qualificationType String
  institution     String
  degree          String?
  fieldOfStudy    String?
  graduationYear  Int?
  certificateUrl  String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schoolStaffProfile SchoolStaffProfile @relation(fields: [schoolStaffProfileId], references: [id], onDelete: Cascade)

  @@index([schoolStaffProfileId])
}

model TeacherAssignment {
  id              String   @id @default(uuid())
  schoolStaffProfileId String
  schoolId        String
  subjectId       String?
  classId         String?
  academicYearId  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schoolStaffProfile SchoolStaffProfile @relation(fields: [schoolStaffProfileId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])
  class Class? @relation(fields: [classId], references: [id])

  @@index([schoolStaffProfileId])
  @@index([schoolId])
  @@index([subjectId])
  @@index([classId])
}

model Class {
  id              String   @id @default(uuid())
  schoolId        String
  name            String
  level           String?
  section         String?
  academicYearId  String?
  capacity        Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classMemberships ClassMembership[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]

  @@index([schoolId])
  @@index([academicYearId])
}

model ClassMembership {
  id              String   @id @default(uuid())
  classId         String
  userId          String
  role            String   @default("student")
  enrolledAt      DateTime @default(now())
  leftAt          DateTime?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([classId])
  @@index([userId])
}

model SchoolAnnouncement {
  id          String   @id @default(uuid())
  schoolId    String
  title       String
  content     String
  priority    String   @default("normal")
  isPinned    Boolean  @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([priority])
  @@index([publishedAt])
}

// ============================================
// SECTION 4: STUDENTS, PARENTS, AND GUARDIANS
// ============================================

model StudentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  studentId       String?  @unique
  dateOfBirth     DateTime?
  gender          String?
  nationality     String?
  nationalId      String?
  bloodGroup      String?
  emergencyContactName String?
  emergencyContactPhone String?
  previousSchool  String?
  admissionDate   DateTime?
  graduationDate  DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentEnrollments StudentEnrollment[]
  studentGuardians StudentGuardian[]
  studentLearningPreferences StudentLearningPreference?
  studentAcademicRecords StudentAcademicRecord[]
  studentNotes StudentNote[]
  assessmentAttempts AssessmentAttempt[]
  aiConversations AiConversation[]
  learningPaths LearningPath[]
  studentProgress StudentProgress[]
  studentSkillMastery StudentSkillMastery[]
  revisionPlans RevisionPlan[]


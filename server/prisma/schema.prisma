  isApproved      Boolean  @default(false)
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  learningResource LearningResource @relation(fields: [learningResourceId], references: [id], onDelete: Cascade)

  @@index([learningResourceId])
  @@index([reviewerId])
  @@index([rating])
}

model ResourcePublicationVersion {
  id              String   @id @default(uuid())
  learningResourceId String
  version         String
  changeNotes     String?

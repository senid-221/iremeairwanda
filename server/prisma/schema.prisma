  completedAt     DateTime?
  createdAt       DateTime @default(now())

  gameMatch GameMatch @relation(fields: [gameMatchId], references: [id], onDelete: Cascade)

  @@unique([gameMatchId, roundNumber])
  @@index([gameMatchId])
}

model GameQuestion {
  id              String   @id @default(uuid())

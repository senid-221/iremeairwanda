model ResourceCategory {
  id          String   @id @default(uuid())
  name        String
  nameEn      String
  nameRw      String?
  description String?
  iconUrl     String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  learningResources LearningResource[]

  @@index([isActive])
}

model LearningResource {
  id              String   @id @default(uuid())
  resourceCategoryId String
  title           String
  titleEn         String
  titleRw         String?
  description     String?
  resourceType    String
  language        String   @default("en")
  source          String?
  publicationYear Int?
  verificationStatus String @default("pending")
  verifiedBy      String?
  verifiedAt      DateTime?
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  accessLevel     String   @default("free")
  downloadCount   Int      @default(0)
  viewCount       Int      @default(0)
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resourceCategory ResourceCategory @relation(fields: [resourceCategoryId], references: [id], onDelete: Cascade)
  resourceCurriculumLinks ResourceCurriculumLink[]
  resourceFiles ResourceFile[]
  resourceAuthors ResourceAuthor[]
  resourceReviews ResourceReview[]
  resourcePublicationVersions ResourcePublicationVersion[]
  resourceAccessLogs ResourceAccessLog[]
  resourceBookmarks ResourceBookmark[]
  studentNotes StudentNote[]

  @@index([resourceCategoryId])
  @@index([resourceType])
  @@index([verificationStatus])
  @@index([isPublished])
  @@index([language])
}

model ResourceCurriculumLink {
  id                  String   @id @default(uuid())
  learningResourceId  String
  curriculumVersionId String?
  educationLevelId    String?
  subjectId           String?
  topicId             String?
  createdAt           DateTime @default(now())

  learningResource LearningResource @relation(fields: [learningResourceId], references: [id], onDelete: Cascade)

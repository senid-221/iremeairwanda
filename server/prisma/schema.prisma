// SECTION 6: ASSESSMENTS, QUESTIONS, AND EXAMINATIONS
// ============================================

model QuestionBank {
  id          String   @id @default(uuid())
  name        String
  description String?
  subjectId   String
  level       String?
  difficulty  String?
  isPublic    Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([subjectId])
  @@index([level])
  @@index([difficulty])
}

model Question {
  id              String   @id @default(uuid())
  questionBankId  String
  subjectTopicId  String?
  questionType    String   @default("multiple_choice")
  questionText    String
  questionTextEn  String?
  questionTextRw  String?
  difficulty      String   @default("medium")
  points          Int      @default(1)
  timeLimitSeconds Int?
  explanation     String?
  explanationEn   String?
  explanationRw   String?
  hint            String?
  mediaUrl        String?
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questionBank QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  subjectTopic SubjectTopic? @relation(fields: [subjectTopicId], references: [id])
  questionOptions QuestionOption[]
  questionCurriculumLinks QuestionCurriculumLink[]
  questionExplanations QuestionExplanation[]
  assessmentQuestions AssessmentQuestion[]
  gameQuestions GameQuestion[]
  studentAnswers StudentAnswer[]

  @@index([questionBankId])
  @@index([subjectTopicId])
  @@index([questionType])
  @@index([difficulty])
}

model QuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  optionText  String
  optionTextEn String?
  optionTextRw String?
  optionOrder Int      @default(0)
  isCorrect   Boolean  @default(false)
  mediaUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([optionOrder])
}

model QuestionCurriculumLink {
  id                  String   @id @default(uuid())
  questionId          String
  curriculumVersionId String?
  educationLevelId    String?
  subjectId           String?
  topicId             String?
  createdAt           DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  curriculumVersion CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])
  educationLevel EducationLevel? @relation(fields: [educationLevelId], references: [id])
  curriculumTopic CurriculumTopic? @relation(fields: [topicId], references: [id])

  @@index([questionId])
  @@index([curriculumVersionId])
  @@index([educationLevelId])
  @@index([subjectId])
}

model QuestionExplanation {
  id              String   @id @default(uuid())
  questionId      String
  explanationText String
  language        String   @default("en")
  explanationType String   @default("detailed")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([language])
}

model Assessment {
  id              String   @id @default(uuid())
  title           String
  titleEn         String?
  titleRw         String?
  description     String?
  assessmentType  String
  subjectId       String?
  educationLevelId String?
  timeLimitMinutes Int?
  totalPoints     Int      @default(0)
  passingScore    Int?
  maxAttempts     Int?
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  startDate       DateTime?
  endDate         DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assessmentQuestions AssessmentQuestion[]
  assessmentAttempts AssessmentAttempt[]

  @@index([assessmentType])
  @@index([subjectId])
  @@index([isPublished])
  @@index([startDate])
}

model AssessmentQuestion {
  id              String   @id @default(uuid())
  assessmentId    String
  questionId      String
  questionOrder   Int      @default(0)
  points          Int?
  isRequired      Boolean  @default(true)
  createdAt       DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@index([questionId])
}

model AssessmentAttempt {
  id              String   @id @default(uuid())
  assessmentId    String
  studentProfileId String
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  timeSpentSeconds Int?
  totalScore      Int?
  maxScore        Int?
  percentage      Decimal?
  status          String   @default("in_progress")
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[]
  assessmentResults AssessmentResult[]

  @@index([assessmentId])
  @@index([studentProfileId])
  @@index([status])
  @@index([startedAt])
}

model StudentAnswer {
  id              String   @id @default(uuid())
  assessmentAttemptId String
  questionId      String
  selectedOptionId String?
  answerText      String?
  isCorrect       Boolean?
  pointsEarned    Int      @default(0)
  timeSpentSeconds Int     @default(0)
  answeredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  assessmentAttempt AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([assessmentAttemptId])
  @@index([questionId])
}

model AssessmentResult {
  id              String   @id @default(uuid())
  assessmentAttemptId String
  totalScore      Int
  maxScore        Int
  percentage      Decimal
  grade           String?
  passed          Boolean?
  remarks         String?
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  assessmentAttempt AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)

  @@index([assessmentAttemptId])
  @@index([grade])
}

model GradingRubric {

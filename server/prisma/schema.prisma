model SubscriptionPlan {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  nameEn          String
  nameRw          String?
  description     String?
  planType        String
  durationMonths  Int
  priceAmount     Decimal  @db.Decimal(10, 2)
  currency        String   @default("RWF")
  features        Json?
  maxUsers        Int?
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userSubscriptions UserSubscription[]
  paymentTransactions PaymentTransaction[]

  @@index([code])
  @@index([planType])
  @@index([isActive])
}

model UserSubscription {
  id              String   @id @default(uuid())
  userId          String
  subscriptionPlanId String
  status          String   @default("active")
  startDate       DateTime
  endDate         DateTime?
  autoRenew       Boolean  @default(false)
  paymentMethod   String?
  lastPaymentAt   DateTime?
  nextBillingAt   DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)
  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@index([subscriptionPlanId])
  @@index([status])
  @@index([endDate])
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  userId          String
  userSubscriptionId String?
  subscriptionPlanId String?
  transactionRef  String   @unique
  providerRef     String?
  provider        String
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("RWF")
  paymentMethod   String?
  paymentType     String
  status          String   @default("pending")
  description     String?
  metadata        Json?
  paidAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  refundedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSubscription UserSubscription? @relation(fields: [userSubscriptionId], references: [id])
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  paymentProviderEvents PaymentProviderEvent[]
  paymentRefunds PaymentRefund[]

  @@index([userId])
  @@index([transactionRef])
  @@index([providerRef])
  @@index([status])
  @@index([createdAt])
}

model PaymentProviderEvent {
  id              String   @id @default(uuid())
  paymentTransactionId String
  eventType       String
  eventId         String   @unique
  eventData       Json
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([paymentTransactionId])
  @@index([eventId])
  @@index([eventType])
}

model PaymentRefund {
  id              String   @id @default(uuid())

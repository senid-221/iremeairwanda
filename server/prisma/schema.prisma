model GameMode {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  nameEn          String
  nameRw          String?
  description     String?
  gameType        String
  minPlayers      Int      @default(1)
  maxPlayers      Int      @default(2)
  totalRounds     Int      @default(10)
  roundTimeSeconds Int     @default(30)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gameLobbies GameLobby[]
  gameMatches GameMatch[]

  @@index([code])
  @@index([gameType])
  @@index([isActive])
}

model GameLobby {
  id              String   @id @default(uuid())
  gameModeId      String
  hostId          String
  subjectId       String?
  educationLevelId String?
  topicId         String?
  difficulty      String   @default("adaptive")
  status          String   @default("waiting")
  maxPlayers      Int      @default(2)
  currentPlayers  Int      @default(1)
  startedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gameMode GameMode @relation(fields: [gameModeId], references: [id], onDelete: Cascade)
  gamePlayers GamePlayer[]
  gameInvitations GameInvitation[]
  matches GameMatch[]

  @@index([gameModeId])
  @@index([hostId])
  @@index([status])
  @@index([createdAt])
}

model GameMatch {
  id              String    @id @default(uuid())
  gameModeId      String?
  gameLobbyId     String?

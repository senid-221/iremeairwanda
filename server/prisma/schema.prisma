  player2Id       String?
  subjectId       String?
  subjectName     String?
  educationLevelId String?
  level           String?
  pathway         String?
  topicId         String?
  topic           String    @default("all")
  difficulty      String    @default("adaptive")
  mode            String    @default("quick")
  totalRounds     Int       @default(10)
  currentRound    Int       @default(0)
  player1Score    Int       @default(0)
  player2Score    Int       @default(0)
  player1Accuracy Int?
  player2Accuracy Int?
  result          String?
  status          String    @default("pending")
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  gameMode GameMode? @relation(fields: [gameModeId], references: [id])
  gameLobby GameLobby? @relation(fields: [gameLobbyId], references: [id])
  player1 User @relation("Player1", fields: [player1Id], references: [id])
  player2 User? @relation("Player2", fields: [player2Id], references: [id])
  gamePlayers GamePlayer[]
  gameRounds GameRound[]
  gameQuestions GameQuestion[]
  gameAnswers GameAnswer[]
  gameScoreEvents GameScoreEvent[]
  gameResults GameResult[]

  @@index([gameModeId])
  @@index([gameLobbyId])
  @@index([player1Id])
  @@index([player2Id])
  @@index([subjectId])
  @@index([status])
  @@index([startedAt])
}

model GamePlayer {
  id              String   @id @default(uuid())
  gameMatchId     String?
  gameLobbyId     String?
  userId          String
  playerNumber    Int
  score           Int      @default(0)
  correctAnswers  Int      @default(0)
  wrongAnswers    Int      @default(0)

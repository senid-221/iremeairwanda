  createdAt       DateTime @default(now())

  gameMatch GameMatch @relation(fields: [gameMatchId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameMatchId])
  @@index([userId])
  @@index([questionId])
  @@index([roundNumber])
}

model GameScoreEvent {
  id              String   @id @default(uuid())
  gameMatchId     String
  userId          String
  roundNumber     Int
  eventType       String
  points          Int
  description     String?
  createdAt       DateTime @default(now())

  gameMatch GameMatch @relation(fields: [gameMatchId], references: [id], onDelete: Cascade)

  @@index([gameMatchId])
  @@index([userId])
  @@index([roundNumber])
  @@index([eventType])
}

model GameResult {

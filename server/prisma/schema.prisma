  ipAddress       String?
  userAgent       String?
  accessedAt      DateTime @default(now())

  learningResource LearningResource @relation(fields: [learningResourceId], references: [id], onDelete: Cascade)

  @@index([learningResourceId])
  @@index([userId])
  @@index([accessType])
  @@index([accessedAt])
}

model ResourceBookmark {
  id              String   @id @default(uuid())
  learningResourceId String
  userId          String

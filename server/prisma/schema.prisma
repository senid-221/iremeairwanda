  storageKey      String?
  fileSize        Int?
  mimeType        String?
  checksum        String?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  learningResource LearningResource @relation(fields: [learningResourceId], references: [id], onDelete: Cascade)

  @@index([learningResourceId])
}

model ResourceAuthor {
  id              String   @id @default(uuid())
  learningResourceId String
  authorName      String
  authorType      String   @default("individual")
  institution     String?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  learningResource LearningResource @relation(fields: [learningResourceId], references: [id], onDelete: Cascade)

  @@index([learningResourceId])
}

